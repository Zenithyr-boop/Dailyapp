# dependencies
node_modules/

# build output
dist/
dev-dist/
*.tsbuildinfo

# env: .env holds the public Firebase web config and IS committed;
# local overrides (.env.local, .env.*.local) are not
.env*.local

# Firebase CLI cache and service account keys — never commit
.firebase/
*-firebase-adminsdk-*.json
service-account*.json

# Android signing keys — never commit
*.keystore
*.jks
# signing passwords for release builds; the keystore itself lives outside the repo (CLAUDE.md → Android)
android/keystore.properties

# logs / OS / editor
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
